<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main class="auth-page">
      <section class="auth-card" aria-labelledby="loginHeading">
        <h1 class="auth-card__heading" id="loginHeading">Login</h1>
        <form action="/auth/login" method="post">
          <div class="form-field">
            <label for="email">Email:</label>
            <input type="text" class="form-control" id="email" name="email" required>
          </div>
          <div class="form-field password-wrapper">
            <label for="password">Password:</label>
            <div class="input-with-eye-icon">
              <input type="password" class="form-control" id="password" name="password" required>
              <button type="button" class="toggle-password-btn">👁️</button>
            </div>
          </div>
          <button class="button button--primary auth-card__submit" type="submit">Login</button>
        </form>
        <%- include("partials/errors") %>
      </section>
      <section class="auth-prompt">
        <p>Don't have an account? <a href="/auth/signup">Sign Up Now</a></p>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/togglePassword.js" defer></script>
  </body>
</html>
