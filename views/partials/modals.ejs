<dialog id="createFolderModal" class="modal">
  <div class="modal__content">
    <h2>Create New Folder</h2>
    <form action="/folders" method="POST">
      <input type="hidden" name="parentId" value="<%= locals.CURRENT_FOLDER_ID || '' %>" />
      <div class="form-field">
        <label for="createFolderName">Folder Name:</label>
        <input type="text" class="form-control" id="createFolderName" name="name" value="<%= locals.LASTPARAMS?.name || '' %>" required />
      </div>
      <% if (locals.OPEN_CREATE_MODAL) { %>
        <%- include("errors") %>
      <% } %>
      <div class="modal__actions">
        <button type="submit" class="button button--primary">Create</button>
        <button type="button" class="button button--secondary" onclick="closeModal('createFolderModal')">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="editFolderModal" class="modal">
  <div class="modal__content">
    <h2>Rename Folder</h2>
    <form id="editFolderForm" action="" method="POST">
      <div class="form-field">
        <label for="editFolderName">New Name:</label>
        <input type="text" class="form-control" id="editFolderName" name="name" value="<%= locals.LASTPARAMS?.name || '' %>" required autocomplete="off" />
      </div>
      <% if (locals.OPEN_FOLDER_UPDATE_MODAL) { %>
        <%- include("errors") %>
      <% } %>
      <div class="modal__actions">
        <button type="submit" class="button button--primary">Rename</button>
        <button type="button" class="button button--secondary" onclick="closeModal('editFolderModal')">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="deleteFolderModal" class="modal">
  <div class="modal__content">
    <h2>Delete Folder</h2>
    <form id="deleteFolderForm" action="" method="POST">
      <div class="form-field">
        <p class="modal__question">Are you sure you want to delete this folder?</p>
      </div>
      <div class="modal__actions">
        <button type="submit" class="button button--danger">Delete</button>
        <button type="button" class="button button--secondary" onclick="closeModal('deleteFolderModal')">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="editFileModal" class="modal">
  <div class="modal__content">
    <h2>Edit File</h2>
    <form id="editFileForm" action="" method="POST">
      <div class="form-field">
        <label for="editFileName">Rename File:</label>
        <input type="text" class="form-control" id="editFileName" name="name" value="<%= locals.LASTPARAMS?.name || '' %>" required autocomplete="off">
      </div>
      <% if (locals.OPEN_FILE_UPDATE_MODAL) { %>
        <%- include("errors") %>
      <% } %>
      <div class="form-field">
        <label for="editFileFolderId">Move To:</label>
        <select id="editFileFolderId" class="form-control" name="folderId"></select>
      </div>
      <div class="modal__actions">
        <button type="submit" class="button button--primary">Save Changes</button>
        <button type="button" class="button button--secondary" onclick="closeModal('editFileModal')">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="deleteFileModal" class="modal">
  <div class="modal__content">
    <h2>Delete File</h2>
    <form id="deleteFileForm" action="" method="POST">
      <div class="form-field">
        <p class="modal__question">Are you sure you want to delete this file?</p>
      </div>
      <div class="modal__actions">
        <button type="submit" class="button button--danger">Delete</button>
        <button type="button" class="button button--secondary" onclick="closeModal('deleteFileModal')">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="fileDetailModal" class="modal">
  <div class="modal__content">
    <h2>File Information</h2>
    <div class="file-details">
      <p><strong>Name:</strong> <span id="File-Name">Loading...</span></p>
      <p><strong>Size:</strong> <span id="File-Size">Loading...</span></p>
      <p><strong>Created At:</strong> <span id="File-Date">Loading...</span></p>
    </div>
    <div class="modal__actions">
      <button type="button" class="button button--secondary" onclick="closeModal('fileDetailModal')">Close</button>
    </div>
  </div>
</dialog>

<dialog id="failedUploadModal" class="modal">
  <div class="modal__content">
    <h2>Upload Failed</h2>

    <%- include("errors") %>

    <div class="modal__actions">
      <button
        type="button"
        class="button button--secondary"
        onclick="closeModal('failedUploadModal')"
      >Close</button>
    </div>
  </div>
</dialog>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    <% if (locals.OPEN_CREATE_MODAL) { %>
      document.getElementById('createFolderModal').showModal();
    <% } %>

    <% if (locals.OPEN_FOLDER_UPDATE_MODAL && locals.CURRENT_FOLDER_ID) { %>
      document.getElementById('editFolderForm').action = '/folders/<%= locals.CURRENT_FOLDER_ID %>/update';
      document.getElementById('editFolderModal').showModal();
    <% } %>

    <% if (locals.OPEN_FILE_UPDATE_MODAL && locals.LAST_FAILED_FILE_ID) { %>
      document.getElementById('editFileForm').action = '/files/<%= locals.LAST_FAILED_FILE_ID %>/update';
      fillFileUpdateModal('<%= locals.LAST_FAILED_FILE_ID %>');
      document.getElementById('editFileModal').showModal();
    <% } %>

    <% if (locals.OPEN_FAILED_UPLOAD_MODAL) { %>
      document.getElementById('failedUploadModal').showModal();
    <% } %>
  });
</script>
