<nav class="main-nav">
  <div class="main-nav__brand">
    <a href="/"><img src="/assets/udrive-logo.svg" alt="UDrive" /></a>
  </div>

  <% if (!locals.currentUser) { %>
    <div class="main-nav__links main-nav__links--visitor">
      <a href="/auth/signup">Sign Up</a>
      <a href="/auth/login">Log In</a>
    </div>
  <% } %>

  <% if (locals.currentUser) { %>
    <div class="main-nav__links main-nav__links--member">
      <form action="/auth/logout" method="POST">
        <button type="submit">Log Out</button>
      </form>
    </div>
  <% } %>
</nav>
