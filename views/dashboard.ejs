<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>

    <main class="page-shell">
      <section class="storage-card" aria-label="Storage usage">
        <div class="storage-card__summary">
          <span>Storage Usage: <strong><%= Number(TOTAL_USAGE).toFixed(2) %> MB</strong> / 50.00 MB</span>
        </div>
        <% const usagePercent = Math.min(100, Math.max(0, (TOTAL_USAGE / 50) * 100)); %>
        <div class="storage-card__track" role="progressbar" aria-label="Storage usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= usagePercent.toFixed(0) %>">
          <div class="storage-card__fill" style="width: <%= usagePercent %>%;"></div>
        </div>
      </section>

      <section class="drive-browser" aria-labelledby="driveHeading">
        <h1 class="drive-browser__heading" id="driveHeading"><%= locals.currentUser.name %>'s Drive (Root)</h1>

        <section class="resource-section" aria-labelledby="foldersHeading">
          <h2 class="resource-section__heading" id="foldersHeading">Folders</h2>
          <% if (FOLDERS.length === 0) { %>
            <p class="resource-section__empty">No folders created yet.</p>
          <% } else { %>
            <div class="resource-grid">
              <% FOLDERS.forEach(function(folder) { %>
                <article class="drive-card drive-card--folder">
                  <div class="drive-card__body" onclick="window.location.href='/folders/<%= folder.id %>'">
                    <span class="drive-card__icon" aria-hidden="true">📁</span>
                    <span class="drive-card__name"><%= folder.name %></span>
                  </div>
                  <div class="drive-card__actions">
                    <button type="button" class="icon-button" onclick="triggerEditFolderModal('<%= folder.id %>', '<%= folder.name %>')">
                      <img src="/assets/edit-icon.png" alt="Edit folder" />
                    </button>
                    <button type="button" class="icon-button" onclick="triggerDeleteFolderModal('<%= folder.id %>')">
                      <img src="/assets/delete-icon.png" alt="Delete folder" />
                    </button>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <section class="resource-section" aria-labelledby="filesHeading">
          <h2 class="resource-section__heading" id="filesHeading">Files</h2>
          <% if (FILES.length === 0) { %>
            <p class="resource-section__empty">No files uploaded yet.</p>
          <% } else { %>
            <div class="resource-grid">
              <% FILES.forEach(function(file) { %>
                <article class="drive-card drive-card--file">
                  <div class="drive-card__body" onclick="triggerDownloadFile('<%= file.id %>')">
                    <span class="drive-card__icon" aria-hidden="true">📄</span>
                    <span class="drive-card__name"><%= file.name %></span>
                  </div>
                  <div class="drive-card__actions">
                    <button type="button" class="icon-button" onclick="triggerEditFileModal('<%= file.id %>')">
                      <img src="/assets/edit-icon.png" alt="Edit file" />
                    </button>
                    <button type="button" class="icon-button" onclick="triggerFileDetailModal('<%= file.id %>')">
                      <img src="/assets/detail-icon.png" alt="File details" />
                    </button>
                    <button type="button" class="icon-button" onclick="triggerDeleteFileModal('<%= file.id %>')">
                      <img src="/assets/delete-icon.png" alt="Delete file" />
                    </button>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>
      </section>

      <section class="drive-toolbar" aria-label="Drive actions">
        <button type="button" class="button button--primary" onclick="triggerCreateFolderModal()">
          <span class="button__icon" aria-hidden="true">➕</span> New Folder
        </button>
        <button type="button" class="button button--primary" onclick="document.getElementById('hiddenFileInput').click()">
          <span class="button__icon" aria-hidden="true">📤</span> Upload File
        </button>

        <form id="autoUploadForm" action="/files/upload" method="POST" enctype="multipart/form-data" hidden>
          <input type="hidden" name="folderId" value="<%= locals.CURRENT_FOLDER_ID || '' %>">
          <input type="hidden" name="name" id="hiddenFileNameInput">
          <input type="file" id="hiddenFileInput" name="file" onchange="handleAutoUpload()">
        </form>
      </section>
    </main>

    <%- include("partials/modals") %>
    <%- include("partials/footer") %>
    <script src="/js/drive.js"></script>
  </body>
</html>
